# DDN Infinia Object Store Configuration
INFINIA_ENDPOINT=https://<infinia-host>:8111
INFINIA_ACCESS_KEY=your_infinia_access_key_here
INFINIA_SECRET_KEY=your_infinia_secret_key_here
INFINIA_BUCKET=ddn-kv-cache-01
INFINIA_REGION=us-east-1

# Local Ollama / vLLM LLM Engine
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
